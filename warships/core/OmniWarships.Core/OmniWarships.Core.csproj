<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OmniWarships.Core</RootNamespace>
    <Description>Noyau de simulation naval OMNI WARSHIPS : deterministe, zero dependance, testable en CI et consommable par Unity.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- specs de navires embarquees : une seule source de verite pour C# et Python -->
    <EmbeddedResource Include="..\..\data\ships\*.ship.txt" />
  </ItemGroup>

</Project>
